# ============================================================
# BirrMetrics API — Environment (EXAMPLE)
# Copy to .env and fill in real values.
# ============================================================
APP_ENV=development
APP_PORT=8080

# DB: host=localhost port=5432 user=postgres password=YOUR_PASSWORD dbname=birrmetrics sslmode=disable
DB_URL=host=localhost port=5432 user=postgres password=YOUR_PASSWORD_HERE dbname=birrmetrics sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25

# Auth — JWT
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080